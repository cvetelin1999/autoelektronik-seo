---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Начало', href: '/', title: 'Отиди към началната страница' },
  { label: 'Условия за ползване' },
];

const keywords = [
  'условия за ползване AutoElektronik',
  'общи условия сервиз автоелектроника',
  'гаранционни условия ремонт на модули',
  'права на потребителите сервизни услуги',
  'ремонт на автоелектроника правила',
];
---

<BaseLayout
  title="Условия за ползване | AutoElektronik"
  description="Официални общи условия за ползване на уебсайта и условия за гаранция при извършване на лабораторни ремонти на автомобилна електроника в AutoElektronik."
  keywords={keywords}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="py-12 lg:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand-700 block mb-2">Правна информация</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Общи условия за ползване на уебсайта и сервизните услуги
        </h1>
        <p class="text-xs text-slate-500 mt-2">Последна актуализация: 20 октомври 2026 г.</p>
      </div>

      <div class="prose prose-slate max-w-none text-sm leading-relaxed space-y-6 text-slate-700">
        
        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">1. Общи разпоредби и идентичност на търговеца</h2>
          <p>
            Настоящите общи условия уреждат взаимоотношенията между посетителите и клиентите на уебсайта <strong class="text-slate-900">autoelektronik-service.bg</strong> и специализирания лабораторен сервиз <strong>AutoElektronik</strong> с адрес на управление: гр. София, бул. „Цариградско шосе“ №115.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">2. Предмет на предоставяните услуги</h2>
          <p>
            Сервизът извършва специализирана диагностика, ремонт на платки, рециклиране и софтуерно препрограмиране на автомобилни електронни блокове (ABS/ESP, ECU двигателни компютри, арматурни табла и комуникационни модули).
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li>Приемането на компоненти за ремонт се извършва на място в сервиза или чрез куриерски компании (Еконт / Спиди).</li>
            <li>Диагностичният съветник на страницата „Открий проблема“ има чисто информационен и ориентировъчен характер и не заменя лабораторната диагностика.</li>
          </ul>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">3. Гаранционни условия и отговорност</h2>
          <p>
            Всеки успешно ремонтиран електронен модул получава поименна писмена гаранционна карта със срок от <strong class="text-slate-900">12 (дванадесет) месеца</strong> от датата на издаване.
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li>Гаранцията покрива възстановените и подменени електронни елементи, писти и спойки.</li>
            <li>Гаранцията отпада при: нарушени гаранционни стикери/пломби; следи от механичен удар; опити за некомпетентна намеса; наводняване/попадане на вода в модула след монтажа; дефектирала външна ел. инсталация в автомобила на клиента, причинила ново късо съединение.</li>
          </ul>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">4. Интелектуална собственост</h2>
          <p>
            Всички авторски текстове, диаграми, графични изображения и софтуерни скриптове, публикувани на този сайт, са обект на авторско право съгласно Закона за авторското право и сродните му права на Република България. Всяко копиране без писмено разрешение е забранено.
          </p>
        </section>

      </div>

    </div>
  </section>
</BaseLayout>
