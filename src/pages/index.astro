---
import BaseLayout from '../layouts/BaseLayout.astro';

const keywords = [
  'ремонт на автомобилна електроника',
  'автодиагностика София',
  'ремонт на ABS модул',
  'ремонт на ECU автокомпютър',
  'ремонт на километражно табло',
];

const serviceCards = [
  {
    title: 'Ремонт на ABS / ESP модули',
    slug: '/uslugi/remont-na-abs-modul/',
    description: 'Лабораторно възстановяване на спирачни модули ATE MK60, Bosch 8.0/9.0, TRW. Рециклиране на соленоидни клапани и бондинг нишки с 12 месеца гаранция.',
    image: '/images/service-abs.svg',
    alt: 'Лабораторен ремонт и микрозапояване на прекъснати проводници в ABS модул',
    iconColor: 'bg-amber-100 text-amber-700',
  },
  {
    title: 'Ремонт на ECU компютри',
    slug: '/uslugi/remont-na-ecu-kompyutar/',
    description: 'Диагностика и ремонт на двигателни компютри (Bosch MED17/EDC17, Delphi, Siemens). Клониране, премахване на имобилайзер и подмяна на крайни стъпала.',
    image: '/images/service-ecu.svg',
    alt: 'Диагностичен стенд за ремонт и тестване на процесори в ECU двигателен компютър',
    iconColor: 'bg-emerald-100 text-emerald-700',
  },
  {
    title: 'Ремонт на автомобилни табла',
    slug: '/uslugi/remont-na-avtomobilno-tablo/',
    description: 'Възстановяване на размазани пиксели, подмяна на стъпкови моторчета за стрелки, ремонт на процесори Jaeger / Magneti Marelli и подсветка.',
    image: '/images/service-tablo.svg',
    alt: 'Сервиз за възстановяване на пиксели и стрелкови уреди на автомобилно табло',
    iconColor: 'bg-blue-100 text-blue-700',
  },
  {
    title: 'Компютърна автодиагностика',
    slug: '/uslugi/avtodiagnostika/',
    description: 'Дълбочинен анализ с цифрови осцилоскопи и дилърски интерфейси. Диагностика на CAN-Bus мрежи, сензори за ъгъл на завиване и реални живи данни.',
    image: '/images/service-diag.svg',
    alt: 'Осцилоскопна компютърна автодиагностика на CAN-Bus електронна шина',
    iconColor: 'bg-purple-100 text-purple-700',
  },
];
---

<BaseLayout
  title="AutoElektronik — Специализиран ремонт на автомобилна електроника в София"
  description="Специализиран лабораторен сервиз за ремонт на ABS модули, ECU двигателни компютри и автомобилни табла. 12 месеца гаранция, оригинални части и бърза диагностика."
  keywords={keywords}
>
  <!-- Hero Section matching Figma palette & UX -->
  <section class="relative bg-gradient-to-b from-brand-900 via-slate-900 to-slate-900 text-white overflow-hidden py-16 lg:py-24">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#2DD4BF_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-800/80 border border-brand-700/60 text-brand-300 text-xs font-semibold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
            Лабораторен сервиз за електронни блокове
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
            Професионален <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-300 to-teal-200">ремонт на автомобилна електроника</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto lg:mx-0">
            Вместо скъпа покупка на чисто нов електронен блок, ние рециклираме дефектиралия модул с високотехнологично оборудване и даваме <strong>12 месеца пълна писмена гаранция</strong>.
          </p>

          <!-- Action buttons with Title attributes per Req #12 -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            <a
              href="/otkrii-problema/"
              title="Стартирай бързия въпросник за локализиране на повредата по симптоми"
              class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-slate-950 font-bold text-base transition-all shadow-lg shadow-brand-500/25 text-center flex items-center justify-center gap-2 group"
            >
              <span>Открий проблема (Онлайн тест)</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href="/uslugi/"
              title="Разгледай всички специализирани услуги за автоелектроника"
              class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-white font-semibold text-base transition-all text-center"
            >
              Виж всички услуги
            </a>
          </div>

          <!-- Trust Badges (List per Req #13) -->
          <ul class="pt-6 grid grid-cols-3 gap-4 border-t border-slate-800/80 text-left">
            <li class="space-y-1">
              <span class="block text-2xl font-bold text-brand-300">12 мес.</span>
              <span class="block text-xs text-slate-400">Писмена гаранция</span>
            </li>
            <li class="space-y-1">
              <span class="block text-2xl font-bold text-brand-300">100%</span>
              <span class="block text-xs text-slate-400">Стенд симулация</span>
            </li>
            <li class="space-y-1">
              <span class="block text-2xl font-bold text-brand-300">24-48ч.</span>
              <span class="block text-xs text-slate-400">Експресен ремонт</span>
            </li>
          </ul>
        </div>

        <!-- Hero Graphic with explicit width, height and alt per Req #10 & #11 -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md lg:max-w-none rounded-2xl overflow-hidden shadow-2xl border border-slate-800">
            <img
              src="/images/hero-car-electronics.svg"
              width="800"
              height="600"
              alt="Схема на автомобилна електроника, компютърни блокове за управление и CAN-Bus мрежа"
              class="w-full h-auto object-cover"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Services Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-700 block mb-2">Нашите специализации</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Ремонт на критични електронни компоненти
        </h2>
        <p class="mt-4 text-base text-slate-600 leading-relaxed">
          Автомобилите от последното десетилетие разчитат на над 50 взаимосвързани компютърни модула. Ние ремонтираме най-натоварените от тях на компонентно ниво.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {serviceCards.map((service) => (
          <article class="flex flex-col bg-slate-50 rounded-2xl border border-slate-200 overflow-hidden hover:shadow-md transition-shadow group">
            <div class="w-full bg-slate-900 flex items-center justify-center overflow-hidden">
              <img
                src={service.image}
                width="800"
                height="500"
                alt={service.alt}
                class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-6 sm:p-8 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
                  {service.title}
                </h3>
                <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                  {service.description}
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
                <a
                  href={service.slug}
                  title={`Научи повече за процедурата по ${service.title}`}
                  class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 hover:text-brand-900 transition-colors"
                >
                  <span>Виж симптоми и цени</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-600">
                  Гаранция 12м.
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Interactive Wizard Promo Banner -->
  <section class="py-16 bg-gradient-to-r from-brand-800 to-brand-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-4 text-center lg:text-left">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-brand-700 text-brand-200">
            Онлайн съветник за симптоми
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            Светна лампа на таблото, но не знаеш какво означава?
          </h2>
          <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
            Използвай нашия автоматизиран въпросник. Алгоритъмът филтрира десетки типични повреди за популярни марки и ти дава точна насока дали модулът подлежи на лабораторен ремонт.
          </p>
        </div>

        <div class="lg:col-span-4 flex justify-center lg:justify-end">
          <a
            href="/otkrii-problema/"
            title="Отвори интерактивния съветник за диагностика на автоелектроника"
            class="px-8 py-4 rounded-xl bg-white text-brand-900 font-extrabold text-base hover:bg-brand-50 shadow-lg hover:shadow-xl transition-all inline-flex items-center gap-2"
          >
            <span>Стартирай теста сега</span>
            <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- How We Work - Process Section (Numbered list per Req #13) -->
  <section class="py-16 lg:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-700 block mb-2">Прозрачен сервизен процес</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
          Как работим в 4 ясни стъпки
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base">
          Приемаме модули както на място в нашия сервиз в София, така и чрез куриерски пратки от цяла България.
        </p>
      </div>

      <!-- Numbered List per Requirement #13 -->
      <ol class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <li class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm relative">
          <div class="w-10 h-10 rounded-xl bg-brand-100 text-brand-800 font-extrabold flex items-center justify-center text-lg mb-4">
            1
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Приемане и оглед</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Визуален и термален оглед под микроскоп за видими следи от късо съединение или проникнала влага.
          </p>
        </li>

        <li class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm relative">
          <div class="w-10 h-10 rounded-xl bg-brand-100 text-brand-800 font-extrabold flex items-center justify-center text-lg mb-4">
            2
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Стендова диагностика</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Включване към специализиран симулационен стенд и осцилоскоп за локализиране на дефектния чип.
          </p>
        </li>

        <li class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm relative">
          <div class="w-10 h-10 rounded-xl bg-brand-100 text-brand-800 font-extrabold flex items-center justify-center text-lg mb-4">
            3
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Хардуерен ремонт</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Прецизно разпояване, подмяна на контролери и ново бондиране на прекъснати проводници.
          </p>
        </li>

        <li class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm relative">
          <div class="w-10 h-10 rounded-xl bg-brand-100 text-brand-800 font-extrabold flex items-center justify-center text-lg mb-4">
            4
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Финален тест и гаранция</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Пълен стрес-тест при работна температура и издаване на 12-месечна писмена гаранционна карта.
          </p>
        </li>
      </ol>

    </div>
  </section>

</BaseLayout>
