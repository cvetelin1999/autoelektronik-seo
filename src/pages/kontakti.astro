---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Начало', href: '/', title: 'Отиди към началната страница' },
  { label: 'Контакти и локация' },
];

const keywords = [
  'сервиз автоелектроника София контакти',
  'адрес сервиз за ремонт на ABS София',
  'телефон сервиз за ремонт на ECU',
  'локация ремонт на автоелектроника Цариградско шосе',
  'приемане на модули по куриер Еконт Спиди',
];
---

<BaseLayout
  title="Контакти и Локация в София | AutoElektronik"
  description="Свържи се с лабораторен сервиз AutoElektronik в София. Адрес: бул. Цариградско шосе №115, телефон: +359 88 812 3456. Google карта с точен пин и форма за запитване."
  keywords={keywords}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Page Header -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-brand-50/70 to-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-brand-100 text-brand-800 mb-3">
        Директна връзка
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
        Контакти и сервизна локация в София
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Заповядайте на място в нашия сервизен център или ни изпратете демонтиран електронен модул по куриер от всяка точка на България.
      </p>
    </div>
  </section>

  <!-- Contacts Info & Contact Form Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Column 1: Contact Details -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-slate-900 tracking-tight mb-4">Информация за сервиза</h2>
            <p class="text-sm text-slate-600 leading-relaxed">
              Нашите инженери са на разположение за предварителна консултация по телефон или имейл. Моля, пригответе марката, модела, годината и записаните кодове за грешка.
            </p>
          </div>

          <!-- Unordered List per Requirement #13 -->
          <ul class="space-y-4">
            <li class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-slate-500">Адрес на сервиза</span>
                <span class="block text-sm font-semibold text-slate-900 mt-0.5">гр. София, бул. „Цариградско шосе“ №115</span>
                <span class="text-xs text-slate-500">Бизнес зона с осигурен удобен паркинг за клиенти</span>
              </div>
            </li>

            <li class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-slate-500">Телефон за връзка</span>
                <a
                  href="tel:+359888123456"
                  title="Обади се директно на нашия сервизен телефон"
                  class="block text-sm font-semibold text-brand-700 hover:underline mt-0.5"
                >
                  +359 88 812 3456
                </a>
                <span class="text-xs text-slate-500">Вайбър и WhatsApp консултации</span>
              </div>
            </li>

            <li class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-slate-500">Електронна поща</span>
                <a
                  href="mailto:office@autoelektronik-service.bg"
                  title="Изпрати имейл запитване към сервиза"
                  class="block text-sm font-semibold text-brand-700 hover:underline mt-0.5"
                >
                  office@autoelektronik-service.bg
                </a>
                <span class="text-xs text-slate-500">Отговор в рамките на работния ден</span>
              </div>
            </li>

            <li class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-slate-500">Работно време</span>
                <span class="block text-sm font-semibold text-slate-900 mt-0.5">Понеделник – Петък: 09:00 – 18:00 ч.</span>
                <span class="text-xs text-slate-500">Събота и Неделя: Почивни дни</span>
              </div>
            </li>
          </ul>

          <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 space-y-1">
            <span class="font-bold block">Приемане на модули по куриер:</span>
            <p>Изпращайте пратките с опция „Преглед“ до офис на Еконт: София — Цариградски комплекс, за AutoElektronik Сервиз.</p>
          </div>
        </div>

        <!-- Column 2: Interactive Contact Form -->
        <div class="lg:col-span-7 bg-slate-50 p-6 sm:p-10 rounded-2xl border border-slate-200">
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight mb-2">Изпрати онлайн запитване</h2>
          <p class="text-sm text-slate-500 mb-6">Попълни данните за автомобила и ще ти върнем ценова оферта и срок.</p>

          <form id="contact-page-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Име и фамилия *</label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="Иван Иванов"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:border-brand-600 focus:ring-1 focus:ring-brand-600 bg-white"
                />
              </div>
              <div>
                <label for="contact-phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Телефон за обратна връзка *</label>
                <input
                  type="tel"
                  id="contact-phone"
                  required
                  placeholder="088 812 3456"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:border-brand-600 focus:ring-1 focus:ring-brand-600 bg-white"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-car" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Марка и модел на автомобила *</label>
                <input
                  type="text"
                  id="contact-car"
                  required
                  placeholder="напр. VW Passat B6 2.0 TDI"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:border-brand-600 focus:ring-1 focus:ring-brand-600 bg-white"
                />
              </div>
              <div>
                <label for="contact-service" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Необходима услуга *</label>
                <select
                  id="contact-service"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:border-brand-600 focus:ring-1 focus:ring-brand-600 bg-white"
                >
                  <option value="abs">Ремонт на ABS / ESP модул</option>
                  <option value="ecu">Ремонт на двигателен компютър (ECU)</option>
                  <option value="tablo">Ремонт на автомобилно табло / дисплей</option>
                  <option value="diag">Компютърна автодиагностика</option>
                  <option value="other">Друг електронен проблем</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Описание на симптомите или кодове за грешка</label>
              <textarea
                id="contact-message"
                rows="4"
                placeholder="Опишете накратко кога се проявява проблемът и какви грешки са записани..."
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:border-brand-600 focus:ring-1 focus:ring-brand-600 bg-white"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 rounded-xl bg-brand-700 hover:bg-brand-800 text-white font-bold text-sm shadow transition-all"
              title="Изпрати формуляра за запитване към сервиз AutoElektronik"
            >
              Изпрати запитване
            </button>

            <p id="contact-form-success" class="text-xs text-emerald-700 font-semibold text-center hidden">
              Благодарим! Вашето съобщение е изпратено успешно. Очаквайте обаждане от наш инженер.
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- Requirement #23: Google Map + Pin Section -->
  <section class="py-12 bg-slate-100 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Локация на сервиза на картата (Google Map + Pin)</h2>
        <p class="text-sm text-slate-500 mt-1">гр. София, бул. „Цариградско шосе“ №115 — Координати: 42.6617° N, 23.3853° E</p>
      </div>

      <!-- Google Maps Embed with Pin (Requirement #23) -->
      <div class="w-full rounded-2xl overflow-hidden shadow-md border border-slate-300 bg-white aspect-[16/9] sm:aspect-[21/9]">
        <iframe
          title="Google Map с точен сервизен пин на AutoElektronik на бул. Цариградско шосе София"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2933.8837130232497!2d23.3831113!3d42.6617001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40aa8683e39075e7%3A0x6b107e0c406085a5!2zYnVsLiAiVHNhcmlncmFkc2tvIHNob3NlIiAxMTUsIFNvZmlh!5e0!3m2!1sen!2sbg!4v1700000000000!5m2!1sen!2sbg"
          width="1200"
          height="500"
          class="w-full h-full border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <script is:inline>
    document.getElementById('contact-page-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const successMsg = document.getElementById('contact-form-success');
      if (successMsg) successMsg.classList.remove('hidden');
    });
  </script>
</BaseLayout>
