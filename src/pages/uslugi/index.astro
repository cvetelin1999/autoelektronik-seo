---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Начало', href: '/', title: 'Отиди към началната страница' },
  { label: 'Услуги по автоелектроника' },
];

const keywords = [
  'сервизни услуги автоелектроника',
  'ремонт на електронни блокове',
  'рециклиране на ABS модули София',
  'ремонт на ECU автокомпютър',
  'възстановяване на автомобилно табло',
];

const services = [
  {
    title: 'Ремонт на ABS / ESP модули',
    slug: '/uslugi/remont-na-abs-modul/',
    lead: 'Лабораторно рециклиране на електронни блокове и соленоидни клапани за спирачни системи.',
    features: [
      'Възстановяване на прекъснати алуминиеви микробондинг проводници',
      'Ремонт на датчици за налягане (G201 / G214)',
      'Поддръжка за ATE MK60, Bosch 5.7/8.0/9.0, TRW Lucas',
      '12 месеца писмена гаранция без ограничение в пробега',
    ],
    image: '/images/service-abs.svg',
    alt: 'Илюстрация на микрозапояване на прекъснати проводници в електронен ABS модул',
  },
  {
    title: 'Ремонт на ECU двигателни компютри',
    slug: '/uslugi/remont-na-ecu-kompyutar/',
    lead: 'Прецизна диагностика, хардуерна подмяна на управляващи драйвери и софтуерно програмиране.',
    features: [
      'Подмяна на дефектирали крайни стъпала за запалителни бобини и инжектори',
      'Клониране на данни от повреден към заместващ компютър 1:1',
      'Възстановяване на 5V референтно захранване към датчиците',
      'Работа с Bosch MED17, EDC16/17, Delphi, Denso, VDO Siemens',
    ],
    image: '/images/service-ecu.svg',
    alt: 'Стенд за диагностика и клониране на ECU двигателен компютър',
  },
  {
    title: 'Ремонт на автомобилни табла',
    slug: '/uslugi/remont-na-avtomobilno-tablo/',
    lead: 'Възстановяване на дисплеи, пиксели, стрелкови уреди и софтуерни грешки на табла.',
    features: [
      'Смяна на дефектирали LCD/OLED дисплеи и лентови кабели (FPC ribbon)',
      'Подмяна на износени стъпкови моторчета за оборотомер и скоростомер',
      'Ремонт на проблемни процесори Motorola/Freescale',
      'Калибриране на индикаторите на тестов стенд',
    ],
    image: '/images/service-tablo.svg',
    alt: 'Ремонт и подмяна на LCD дисплей и стрелкови моторчета на автомобилно табло',
  },
  {
    title: 'Компютърна автодиагностика и CAN-Bus',
    slug: '/uslugi/avtodiagnostika/',
    lead: 'Дълбочинен анализ с цифрови осцилоскопи за откриване на трудни за хващане проблеми.',
    features: [
      'Анализ на формата на сигнала по CAN-H и CAN-L шините',
      'Проверка на комуникацията между Gateway, ABS, ECU и табло',
      'Разчитане на реални живи данни (Live Data) в движение',
      'Локализиране на паразитна консумация и утечки на ток',
    ],
    image: '/images/service-diag.svg',
    alt: 'Цифров осцилоскоп показващ формата на сигнала по автомобилна CAN-Bus мрежа',
  },
];
---

<BaseLayout
  title="Услуги по ремонт на автомобилна електроника — AutoElektronik"
  description="Пълен каталог със специализирани услуги за автоелектроника: ремонт на ABS помпи, ECU двигателни компютри, километражни табла и осцилоскопна автодиагностика."
  keywords={keywords}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Page Header -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-brand-50/60 to-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-brand-100 text-brand-800 mb-3">
        Специализиран каталог
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
        Услуги по ремонт на автомобилна електроника
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Високотехнологичен лабораторен сервиз в София. Възстановяваме дефектирали електронни блокове с оригинални сертифицирани компоненти и 12 месеца гаранция.
      </p>
    </div>
  </section>

  <!-- Detailed Services Listing -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {services.map((service, index) => (
        <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center p-6 sm:p-10">
            
            <div class={`lg:col-span-6 space-y-4 ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
              <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
                {service.title}
              </h2>
              <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                {service.lead}
              </p>
              
              <!-- Unordered List per Requirement #13 -->
              <ul class="space-y-2 pt-2">
                {service.features.map((feat) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-700">
                    <svg class="w-5 h-5 text-brand-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-4 flex flex-wrap items-center gap-4">
                <a
                  href={service.slug}
                  title={`Прегледай подробно описание, симптоми и цени за ${service.title}`}
                  class="px-6 py-3 rounded-xl bg-brand-700 hover:bg-brand-800 text-white font-semibold text-sm transition-all shadow-sm inline-flex items-center gap-2"
                >
                  <span>Виж пълна информация</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
                <a
                  href="/otkrii-problema/"
                  title="Тествай автомобила с онлайн въпросника за симптоми"
                  class="px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm transition-all"
                >
                  Провери симптом
                </a>
              </div>
            </div>

            <!-- Image with explicit width, height and alt per Req #10 & #11 -->
            <div class={`lg:col-span-6 ${index % 2 === 1 ? 'lg:order-1' : ''}`}>
              <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-900">
                <img
                  src={service.image}
                  width="800"
                  height="500"
                  alt={service.alt}
                  class="w-full h-auto object-cover hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
            </div>

          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
