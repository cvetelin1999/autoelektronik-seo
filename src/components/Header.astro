---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { href: '/', label: 'Начало', title: 'Отиди към началната страница на сервиз AutoElektronik' },
  { href: '/uslugi/', label: 'Услуги', title: 'Разгледай пълния каталог със сервизни услуги за автоелектроника' },
  { href: '/otkrii-problema/', label: 'Открий проблема', title: 'Интерактивен съветник за първоначална автодиагностика по симптоми' },
  { href: '/za-nas/', label: 'За нас', title: 'Научи повече за опита, сервизното оборудване и гаранцията на AutoElektronik' },
  { href: '/kontakti/', label: 'Контакти', title: 'Свържи се с наш специалист и виж адрес, локация и телефон' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo / Identity -->
      <div class="flex-shrink-0 flex items-center gap-3">
        <a 
          href="/" 
          class="flex items-center gap-2.5 group" 
          title="AutoElektronik - Специализиран сервиз за автомобилна електроника"
        >
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-700 to-brand-900 flex items-center justify-center text-white shadow-md shadow-brand-700/20 group-hover:scale-105 transition-transform duration-200">
            <svg width="24" height="24" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-brand-700 transition-colors">
              Auto<span class="text-brand-700">Elektronik</span>
            </span>
            <span class="text-[10px] tracking-wider uppercase text-slate-500 font-medium">Сервиз & Лаборатория</span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation - Strict list per Requirement #13 -->
      <nav class="hidden md:block" aria-label="Основна навигация">
        <ul class="flex items-center space-x-1 lg:space-x-2">
          {navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  title={item.title}
                  class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors duration-150 inline-block ${
                    isActive
                      ? 'text-brand-700 bg-brand-50 font-semibold'
                      : 'text-slate-700 hover:text-brand-700 hover:bg-slate-100'
                  }`}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Desktop CTA Button -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/otkrii-problema/"
          title="Стартирай бързия въпросник за ориентировъчна диагноза на повредата"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-700 text-white text-sm font-semibold hover:bg-brand-800 transition-all shadow-sm hover:shadow hover:-translate-y-0.5 duration-150"
        >
          <svg width="16" height="16" class="w-4 h-4 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <span>Диагностичен тест</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center md:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-700"
          title="Отвори главното навигационно меню"
        >
          <span class="sr-only">Отвори главното меню</span>
          <svg width="24" height="24" id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg width="24" height="24" id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Panel -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white">
    <nav aria-label="Мобилна навигация" class="px-4 pt-3 pb-6">
      <ul class="space-y-1.5">
        {navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <li>
              <a
                href={item.href}
                title={item.title}
                class={`block px-3 py-2.5 rounded-lg text-base font-medium ${
                  isActive
                    ? 'text-brand-700 bg-brand-50 font-semibold'
                    : 'text-slate-700 hover:text-brand-700 hover:bg-slate-50'
                }`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="mt-4 pt-4 border-t border-slate-100">
        <a
          href="/otkrii-problema/"
          title="Стартирай бързия диагностичен тест"
          class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-brand-700 text-white font-semibold text-center hover:bg-brand-800 shadow"
        >
          <span>Открий проблема (Диагностика)</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (mobileMenuBtn && mobileMenu && openIcon && closeIcon) {
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
